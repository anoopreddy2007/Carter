# =============================================================================
# Carter .gitignore
# =============================================================================

# --- Virtual environments ---
.venv/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# --- Model files (large binary files — store separately, never in git) ---
models/llm/*.gguf
models/llm/*.bin
models/llm/*.safetensors
models/ml/*.joblib
models/ml/*.pkl
models/ml/*.pt
models/ml/*.pth
models/adapters/

# --- Data (may be large or sensitive) ---
data/raw/
data/processed/

# --- Artifacts and outputs ---
artifacts/checkpoints/
artifacts/logs/
artifacts/*.db
*.db
*.sqlite
*.sqlite3

# --- Configuration with local paths (never commit) ---
configs/carter.yaml

# --- Wheelhouse (offline package cache — store on separate media) ---
wheelhouse/

# --- OS files ---
Thumbs.db
.DS_Store
desktop.ini

# --- IDE ---
.vscode/settings.json
.idea/
*.swp
*.swo

# --- Pytest ---
.pytest_cache/
.coverage
htmlcov/

# --- Jupyter (if used for experimentation) ---
*.ipynb_checkpoints/
